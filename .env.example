# Optionaler zentraler Hauptschlüssel. Alternativ können Schlüssel unter API
# in der Oberfläche erstellt werden; diese werden nur gehasht in D1 gespeichert.
GERIDB_API_KEY=replace-with-a-long-random-secret

# Optional: Browser-Ursprung, der die API aufrufen darf. Für n8n lokal z. B.:
GERIDB_ALLOWED_ORIGIN=http://localhost:5678
